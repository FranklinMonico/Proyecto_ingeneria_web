# En desarrollo, el API se llama por proxy (vite.config.ts → localhost:8081).
# No hace falta VITE_API_URL aquí salvo que hagas build/preview y quieras forzar URL.
# VITE_API_URL=http://localhost:8081

# Si el backend corre en otro host:puerto, úsalo para el proxy:
# (PowerShell) $env:VITE_PROXY_TARGET="http://localhost:9090"; npm run dev
# VITE_PROXY_TARGET=http://localhost:8081
